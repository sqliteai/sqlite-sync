{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Attach to Postgres (gdb)",
      "type": "cppdbg",
      "request": "attach",
      "program": "/usr/lib/postgresql/16/bin/postgres",
      "processId": "${command:pickProcess}",
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "stopAtEntry": false,
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}
